# Only needed for the OpenAI (GPT-4.1 nano) experiments.
OPENAI_API_KEY=...

# Open-weight experiments (Qwen2.5-7B-Instruct).
# HF_TOKEN: optional for downloading Qwen (public); needed with *write* scope only if you set
# HF_USER_ID so that adapters are also pushed to the Hub. `huggingface-cli login` works too.
HF_TOKEN=
HF_USER_ID=
# Where LoRA adapters are saved locally (always).
FT_OUTPUT_DIR=./data/models
VLLM_LOGGING_LEVEL=INFO
VLLM_N_GPUS=1
VLLM_MAX_LORA_RANK=8
VLLM_MAX_NUM_SEQS=512
